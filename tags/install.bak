	}
	if(!$_GET[step]){
	 $step = $_POST[step];
	} else {
	 $step = $_GET[step];
	}
	if(!$step){
	 $step="1";
	} elseif ($step=="2") {
	 $domain = eregi_replace("www.","",$_SERVER[HTTP_HOST]);
	 $domain = ".".$domain;
	 setCookie("password",$_POST[password],time()+(365*(3600*24)),"/",$domain);
